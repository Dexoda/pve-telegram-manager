# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# Proxmox Configuration
PVE_HOST=192.168.1.100
PVE_PORT=8006
PVE_USER=root@pam
PVE_TOKEN_NAME=your_token_name
PVE_TOKEN_VALUE=your_token_value
PVE_VERIFY_SSL=false

# SSH Configuration (for Tailscale access)
SSH_HOST=192.168.1.100
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=your_ssh_password
# Or use SSH key (optional)
SSH_KEY_PATH=/path/to/private/key

# Database
DATABASE_PATH=data/bot.db

# Electricity Tariff (Almaty, Kazakhstan)
ELECTRICITY_RATE=21.80
