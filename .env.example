# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
ADMIN_IDS=12345678,87654321

# Proxmox API Configuration (Token-based auth)
PVE_HOST=100.64.0.1
PVE_PORT=8006
PVE_USER=root@pam
PVE_TOKEN_NAME=bot
PVE_TOKEN_VALUE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PVE_VERIFY_SSL=false

# SSH Configuration (via Tailscale)
SSH_HOST=100.64.0.1
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=
SSH_KEY_PATH=/root/.ssh/id_rsa

# Electricity Tariff (Almaty, Kazakhstan - KZT per kWh)
TARIFF_STEP_1=23.21
TARIFF_STEP_2=28.50
TARIFF_STEP_3=35.00
CURRENCY=KZT

# Database Configuration
DATABASE_PATH=./data/bot.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./data/bot_usage.log

# Alert Configuration
ALERT_HIGH_LOAD_THRESHOLD=90
ALERT_HIGH_LOAD_DURATION=300
ALERT_CHECK_INTERVAL=60
